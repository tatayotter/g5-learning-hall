# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

repomix-output.md
repomix-output.xml

# android (Capacitor)
/android/app/build/
/android/build/
/android/.gradle/
/android/local.properties
/android/captures/
/android/app/release/
/android/keystore.properties
/android/keystore/

# offline-shell (separate build, own node_modules/build output — see plan doc)
/offline-shell/node_modules/
/offline-shell/out/
/offline-shell/.next/
/offline-shell/next-env.d.ts
/offline-shell/*.tsbuildinfo

# offline-shell/public is now a full generated mirror of root public/ (see
# scripts/sync-offline-shell-public.js, run automatically as a "prebuild"
# step) rather than a hand-curated subset — not source, shouldn't be committed.
/offline-shell/public/

# Capacitor's copy of the bundled web assets (public/, webcache_seed/) into
# the native project — regenerated by `npx cap sync`, not source.
/android/app/src/main/assets/

# offline-shell's build output, copied wholesale into www/ by the Android CI
# workflow right before `cap sync` (www/ is never used by the online path —
# server.url always overrides it) — not source, shouldn't be committed.
/www/


graphify-out/
supabase/.temp/
