# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

repomix-output.md
repomix-output.xml

# android (Capacitor)
/android/app/build/
/android/build/
/android/.gradle/
/android/local.properties
/android/captures/
/android/app/release/
/android/keystore.properties
/android/keystore/

# offline-shell (separate build, own node_modules/build output — see plan doc)
/offline-shell/node_modules/
/offline-shell/out/
/offline-shell/.next/
/offline-shell/next-env.d.ts
/offline-shell/*.tsbuildinfo

# offline-shell's build output, copied into www/offline by the Android CI
# workflow right before `cap sync` — not source, shouldn't be committed.
/www/offline/

